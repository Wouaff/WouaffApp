# ── Serveur ─────────────────────────────────────────────────────────────────
PORT=7285
# URL publique de l'application (CORS + liens envoyés par e-mail)
APP_URL=http://localhost:7285
# Derrière un reverse proxy (nginx, Caddy…) : 1 pour que l'IP réelle soit vue (rate-limit)
# TRUST_PROXY=1

# Chiffrement des secrets de double authentification (TOTP) en base : 64 caractères hexadécimaux.
# Générer avec : openssl rand -hex 32   — À CONSERVER : sans cette clé, les comptes ayant la 2FA ne peuvent plus se connecter.
# TOTP_ENCRYPTION_KEY=

# Balayage horaire des fichiers envoyés mais jamais publiés (> 24 h). Mettre « off » pour le désactiver.
# UPLOAD_SWEEP=off

# Démarrer malgré une migration SQL en échec (déconseillé : par défaut le serveur s'arrête).
# MIGRATE_IGNORE_FAILURES=1

# ── MySQL / MariaDB ─────────────────────────────────────────────────────────
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=wouaff

# ── E-mails (vérification d'adresse, mot de passe oublié) — optionnel ──────
# Sans SMTP_HOST et SMTP_FROM, ces fonctions sont désactivées proprement.
# SMTP_HOST=smtp.exemple.fr
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="Wouaff <no-reply@exemple.fr>"

# ── Captcha Cloudflare Turnstile à l'inscription — optionnel ───────────────
# Définir aussi VITE_TURNSTILE_SITE_KEY côté client (client/.env).
# TURNSTILE_SECRET_KEY=
# TURNSTILE_HOSTNAME=wouaff.app
