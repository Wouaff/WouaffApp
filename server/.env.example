# Serveur Wouaff
PORT=3000
APP_URL=http://localhost:5173

# MySQL
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=wouaff

# SMTP (emails de vérification / réinitialisation)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Wouaff" <noreply@wouaff.fr>

# Boîte de réception du formulaire de contact (laisser vide pour désactiver le canal)
CONTACT_EMAIL=

# Cloudflare Turnstile (anti-spam) — laisser vide pour désactiver
TURNSTILE_SECRET_KEY=
# Hôte et action attendus dans la réponse Turnstile (optionnel, recommandé en production)
TURNSTILE_HOSTNAME=
TURNSTILE_ACTION=
# Mettre à 1 pour désactiver complètement le CAPTCHA (déconseillé en production)
CAPTCHA_DISABLED=

# Chiffrement applicatif des secrets TOTP au repos (32 octets en base64 ou 64 caractères hex)
# Générer avec : node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Si vide, les secrets restent stockés en clair (comportement historique).
TOTP_ENCRYPTION_KEY=

# Secret requis pour POST /api/admin/bootstrap (recommandé)
ADMIN_BOOTSTRAP_SECRET=

# Nombre de proxies de confiance devant le serveur (1 par défaut, false pour désactiver)
TRUST_PROXY=
# Mettre à 1 si Cloudflare est devant le serveur (utilise CF-Connecting-IP comme IP client)
TRUST_CF_CONNECTING_IP=

# IndexNow (push instantané aux moteurs de recherche) — laisser vide pour désactiver
INDEXNOW_KEY=
