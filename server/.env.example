# Serveur Wouaff
PORT=3000
APP_URL=http://localhost:5173

# MySQL
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=wouaff

# SMTP (emails de vérification / réinitialisation)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Wouaff" <noreply@wouaff.fr>

# Cloudflare Turnstile (anti-spam) — laisser vide pour désactiver
TURNSTILE_SECRET_KEY=

# IndexNow (push instantané aux moteurs de recherche) — laisser vide pour désactiver
INDEXNOW_KEY=
